<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Drop a Thought | Club Room</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Barrio&family=Outfit:wght@300;400;500;600;700&family=Permanent+Marker&family=Space+Mono:wght@400;700&family=Syne:wght@700;800&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/style.css">

    <style>
        body {
            font-family: 'Outfit', sans-serif;
        }

        .font-display {
            font-family: 'Syne', sans-serif;
        }

        .font-mono {
            font-family: 'Space Mono', monospace;
        }

        .font-brand {
            font-family: 'Barrio', system-ui;
        }

        .font-brush {
            font-family: 'Permanent Marker', cursive;
        }

        .vertical-text {
            writing-mode: vertical-rl;
            text-orientation: mixed;
        }
    </style>
</head>

<body
    class="bg-zinc-50 min-h-screen w-full flex antialiased text-black selection:bg-black selection:text-white overflow-x-hidden">

    <div
        class="hidden xl:flex flex-col justify-between border-r-[3px] border-black w-24 p-6 shrink-0 bg-[#FFE600] h-screen sticky top-0 z-50">
        <div class="font-mono text-sm font-bold tracking-widest text-black/70">06</div>

        <div class="flex-1 flex items-center justify-center">
            <h1 class="font-brand vertical-text rotate-180 text-5xl font-bold whitespace-nowrap">
                Write
            </h1>
        </div>

        <div class="text-3xl font-black text-black text-center">書</div>
    </div>

    <div class="flex-1 flex flex-col min-h-screen w-full bg-zinc-50 relative">

        <header
            class="py-2.5 sm:py-6 border-b-[3px] gap-3 border-black flex justify-between items-center flex-wrap px-3 sm:px-6 xl:px-10 shrink-0 bg-white sticky top-0 z-40">
            <div class="font-brand text-2xl font-bold tracking-widest">
                ClubRoom
            </div>
            <nav class="flex gap-4">
                <a href="/app"
                    class="font-mono text-sm font-black px-3 py-1.5 border-[3px] border-black uppercase tracking-widest hover:bg-black hover:text-[#FFE600] transition-colors duration-300 flex items-center gap-2">
                    <span>←</span> Return to Feed
                </a>
            </nav>
        </header>

        <main class="flex-1 p-2.5 sm:p-6 xl:p-10 flex flex-col relative w-full">

            <div
                class="absolute right-10 bottom-10 text-[20rem] font-black text-black opacity-[0.03] pointer-events-none select-none">
                書
            </div>

            <div class="w-full bg-transparent pt-4  relative z-10">

                <div
                    class="mb-10 pb-6 flex flex-col md:flex-row md:items-end justify-between border-b-[3px] border-black">
                    <h2 class="flex flex-col leading-[0.9]">
                        <span class="font-display text-4xl md:text-6xl font-semibold uppercase tracking-tighter">Draft
                            Your</span>
                        <span class="font-brush text-5xl md:text-7xl mt-2 transform -rotate-2 text-transparent"
                            style="-webkit-text-stroke: 2px black;">Message.</span>
                    </h2>

                </div>

                <form action="/app/new-message" method="post" enctype="multipart/form-data"
                    class="flex flex-col gap-8 w-full">

                    <div class="flex flex-col gap-2">
                        <label for="title"
                            class="font-mono text-sm font-bold uppercase tracking-widest text-black">Enter Title</label>
                        <input value="<%=locals.oldInput?.title || '' %>" type="text" id="title" name="title" class="w-full border-[3px] border-black p-3 sm:p-4 text-xl font-bold bg-white focus:bg-[#FFE600]
                        focus:outline-none focus:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all
                        placeholder:text-zinc-400 font-mono" placeholder="What's on your mind?">
                        <% if (locals.errors?.title) { %>
                            <div
                                class="bg-red-500 text-white font-mono text-[10px] uppercase tracking-wider font-bold p-2 border-[2px] border-black mt-1">
                                <%= errors.title.msg %>
                            </div>
                            <% } %>
                    </div>

                    <div class="flex flex-col gap-2">
                        <label for="message"
                            class="font-mono text-sm font-bold uppercase tracking-widest text-black">Enter
                            Message</label>
                        <textarea name="message" id="message" rows="8"
                            class="w-full border-[3px] border-black p-3 sm:p-4 text-lg font-medium bg-white focus:bg-[#FFE600] focus:outline-none focus:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all placeholder:text-zinc-400 resize-y"
                            placeholder="Write your thoughts here..."><%= locals.oldInput?.message || '' %></textarea>
                        <% if (locals.errors?.message) { %>
                            <div
                                class="bg-red-500 text-white font-mono text-[10px] uppercase tracking-wider font-bold p-2 border-[2px] border-black mt-1">
                                <%= errors.message.msg %>
                            </div>
                            <% } %>
                    </div>

                    <div class="flex flex-col gap-3">

                        <% if (is_member) { %>
                            <div
                                class="flex flex-col gap-2 p-3 sm:p-6 border-[3px] border-black bg-zinc-200 relative h-full justify-center">
                                <div
                                    class="absolute top-0 right-0 bg-black text-[#FFE600] font-mono text-[10px] font-bold px-2 py-1 uppercase tracking-widest border-b-[3px] border-l-[3px] border-black">
                                    Member Feature
                                </div>
                                <label for="image"
                                    class="font-mono text-sm font-bold uppercase tracking-widest text-black mb-2 mt-2">Attach
                                    Image (Optional)</label>

                                <input type="file" name="image" id="image" accept="image/*"
                                    class="w-full text-sm font-mono text-zinc-500 file:mr-4 file:py-3 file:px-4 file:rounded-none file:border-[3px] file:border-black file:text-sm file:font-mono file:font-bold file:bg-[#FFE600] file:text-black hover:file:bg-black hover:file:text-[#FFE600] file:transition-all file:cursor-pointer cursor-pointer">
                                <% if (locals.errors?.image) { %>
                                    <div
                                        class="bg-red-500 text-white font-mono text-[10px] uppercase tracking-wider font-bold p-2 border-[2px] border-black mt-1">
                                        <%= errors.image.msg %>
                                    </div>
                                    <% } %>
                            </div>
                            <% } else { %>
                                <div
                                    class="flex flex-col items-center justify-center p-8 border-[3px] border-black border-dashed bg-zinc-200 relative overflow-hidden group h-full">

                                    <div
                                        class="absolute right-0 bottom-0 text-[10rem] font-black text-black opacity-5 pointer-events-none translate-x-1/4 translate-y-1/4">
                                        鎖 </div>

                                    <div
                                        class="font-mono text-sm font-bold uppercase tracking-widest text-zinc-500 mb-6 text-center z-10">
                                        🔒 Image attachments are locked for guests.
                                    </div>
                                    <a href="/member"
                                        class="bg-white text-black border-[3px] border-black font-mono font-black uppercase text-xs px-6 py-3 hover:bg-black hover:text-[#FFE600] hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all z-10">
                                        Become a Member
                                    </a>
                                </div>
                                <% } %>

                                    <button type="submit"
                                        class="w-full bg-black cursor-pointer max-w-[350px] text-[#FFE600] border-[3px] border-black font-mono font-black uppercase tracking-widest text-lg py-3 hover:bg-[#FFE600] hover:text-black hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] transition-all duration-300 flex items-center justify-center gap-3 group">
                                        Post to Wall
                                        <span
                                            class="text-2xl group-hover:translate-y-[-4px] group-hover:translate-x-1 transition-transform">↗</span>
                                    </button>

                    </div>

                </form>

            </div>
        </main>
    </div>

</body>

</html>