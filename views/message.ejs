<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Drop a Thought | Club Room</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Barrio&family=Outfit:wght@300;400;500;600;700&family=Permanent+Marker&family=Space+Mono:wght@400;700&family=Syne:wght@700;800&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/style.css">

    <style>
        body {
            font-family: 'Outfit', sans-serif;
        }

        .font-display {
            font-family: 'Syne', sans-serif;
        }

        .font-mono {
            font-family: 'Space Mono', monospace;
        }

        .font-brand {
            font-family: 'Barrio', system-ui;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-track {
            background: #f4f4f5;
            border-left: 2px solid black;
        }

        ::-webkit-scrollbar-thumb {
            background: black;
            border: 2px solid #f4f4f5;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #FFE600;
        }
    </style>
</head>

<body
    class="bg-zinc-50 min-h-screen w-full flex flex-col antialiased text-black selection:bg-black selection:text-white overflow-x-hidden">

    <!-- Global Full-Width Header -->
    <header class="w-full border-b-[3px] border-black bg-white sticky top-0 z-50">
        <div class="max-w-5xl mx-auto min-h-[4rem] flex justify-between items-center px-4 md:px-6 py-3">
            <div class="font-brand text-2xl font-bold tracking-widest">
                ClubRoom
            </div>
            <nav class="flex gap-4">
                <a href="/app"
                    class="font-mono text-xs font-bold px-4 py-2 border-[2px] border-black hover:bg-black hover:text-[#FFE600] uppercase tracking-widest transition-all flex items-center gap-2">
                    <span>←</span> Back to Feed
                </a>
            </nav>
        </div>
    </header>

    <!-- Minimal Header Section -->
    <section class="w-full bg-white border-b-[3px] border-black">
        <div class="max-w-5xl mx-auto px-4 md:px-6 py-10 md:py-12">

            <h1 class="font-display text-4xl md:text-5xl font-semibold uppercase tracking-tighter mb-4 text-black">
                Draft your message.
            </h1>
            <p class="text-base font-medium text-zinc-600 border-l-[3px] border-[#FFE600] pl-4 max-w-lg">
                Speak your mind. Share an update, a thought, or an image with the room.
            </p>

        </div>
    </section>

    <!-- Centered Form Container -->
    <main class="w-full flex-1 bg-zinc-50 py-10 px-4 md:px-6 flex flex-col items-center">

        <div class="w-full max-w-3xl relative z-10">

            <form id="postForm" action="/app/new-message" method="post" enctype="multipart/form-data"
                class="flex flex-col gap-6 w-full">

                <!-- Title Input -->
                <div class="flex flex-col gap-2">
                    <label for="title" class="font-mono text-xs font-bold uppercase tracking-widest text-zinc-600">Enter
                        Title</label>
                    <input value="<%=locals.oldInput?.title || '' %>" type="text" id="title" name="title"
                        class="w-full border-[2px] border-black p-3 sm:p-4 text-lg font-bold bg-white focus:bg-[#FFE600] focus:outline-none focus:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all placeholder:text-zinc-400 font-mono"
                        placeholder="What's on your mind?">

                    <% if (locals.errors?.title) { %>
                        <div
                            class="bg-red-500 text-white font-mono text-[10px] uppercase tracking-wider font-bold p-2 border-[2px] border-black mt-1">
                            <%= errors.title.msg %>
                        </div>
                        <% } %>
                </div>

                <!-- Message Textarea -->
                <div class="flex flex-col gap-2">
                    <label for="message"
                        class="font-mono text-xs font-bold uppercase tracking-widest text-zinc-600">Enter
                        Message</label>
                    <textarea name="message" id="message" rows="8"
                        class="w-full border-[2px] border-black p-3 sm:p-4 text-base font-medium bg-white focus:bg-[#FFE600] focus:outline-none focus:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all placeholder:text-zinc-400 resize-y"
                        placeholder="Write your thoughts here..."><%= locals.oldInput?.message || '' %></textarea>

                    <% if (locals.errors?.message) { %>
                        <div
                            class="bg-red-500 text-white font-mono text-[10px] uppercase tracking-wider font-bold p-2 border-[2px] border-black mt-1">
                            <%= errors.message.msg %>
                        </div>
                        <% } %>
                </div>

                <!-- Image Upload (Role Based) -->
                <div class="flex flex-col gap-3 mt-2">
                    <% if (is_member) { %>
                        <div class="flex flex-col gap-2 p-4 sm:p-6 border-[2px] border-black bg-zinc-100 relative">
                            <div
                                class="absolute top-0 right-0 bg-black text-[#FFE600] font-mono text-[9px] font-bold px-2 py-1 uppercase tracking-widest border-b-[2px] border-l-[2px] border-black">
                                Member Feature
                            </div>

                            <label for="image"
                                class="font-mono text-xs font-bold uppercase tracking-widest text-zinc-600 mb-2 mt-2">
                                Attach Image (Optional)
                            </label>

                            <input type="file" name="image" id="image" accept="image/*"
                                class="w-full text-xs font-mono text-zinc-500 file:mr-4 file:py-2 file:px-4 file:rounded-none file:border-[2px] file:border-black file:text-xs file:font-mono file:font-bold file:bg-[#FFE600] file:text-black hover:file:bg-black hover:file:text-[#FFE600] file:transition-all file:cursor-pointer cursor-pointer">

                            <% if (locals.errors?.image) { %>
                                <div
                                    class="bg-red-500 text-white font-mono text-[10px] uppercase tracking-wider font-bold p-2 border-[2px] border-black mt-1">
                                    <%= errors.image.msg %>
                                </div>
                                <% } %>
                        </div>
                        <% } else { %>
                            <!-- Locked State for Guests -->
                            <div
                                class="flex flex-col items-center justify-center p-8 border-[2px] border-black border-dashed bg-zinc-200 relative overflow-hidden group">
                                <div
                                    class="absolute right-0 bottom-0 text-[8rem] font-black text-black opacity-5 pointer-events-none translate-x-1/4 translate-y-1/4">
                                    鎖
                                </div>

                                <div
                                    class="font-mono text-xs font-bold uppercase tracking-widest text-zinc-500 mb-4 text-center z-10">
                                    🔒 Image attachments are locked for guests.
                                </div>
                                <a href="/member"
                                    class="bg-white text-black border-[2px] border-black font-mono font-bold uppercase text-[10px] px-4 py-2 hover:bg-black hover:text-[#FFE600] hover:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all z-10">
                                    Become a Member
                                </a>
                            </div>
                            <% } %>
                </div>

                <button type="submit" id="submitBtn"
                    class="mt-4 w-full cursor-pointer bg-[#FFE600] text-black border-[2px] border-black font-mono font-bold uppercase tracking-widest text-sm py-4 hover:bg-black hover:text-[#FFE600] hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all duration-300 flex items-center justify-center gap-3 group">
                    <span id="btnText">Post to Wall</span>
                    <span id="btnIcon" class="text-xl group-hover:translate-x-1 transition-transform">→</span>
                </button>

            </form>
        </div>
    </main>

    <!-- Simple Footer -->
    <footer class="w-full bg-white border-t-[3px] border-black py-6 text-center mt-auto">
        <div class="font-mono text-[10px] font-bold uppercase tracking-widest text-zinc-500">
            Created by <a target="_blank" class="text-black hover:underline"
                href="https://github.com/sayeed-dev-07">Sayeed</a>
        </div>
    </footer>


    <script>
        const form = document.getElementById('postForm');
        const submitBtn = document.getElementById('submitBtn');
        const btnText = document.getElementById('btnText');
        const btnIcon = document.getElementById('btnIcon');

        form.addEventListener('submit', function () {

            submitBtn.disabled = true;


            submitBtn.classList.remove('bg-[#FFE600]', 'hover:bg-black', 'hover:text-[#FFE600]', 'hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]', 'cursor-pointer');


            submitBtn.classList.add('bg-zinc-200', 'text-zinc-500', 'cursor-wait');


            btnText.innerText = 'Uploading Post...';


            btnIcon.innerText = '⏳';
            btnIcon.classList.remove('group-hover:translate-x-1');
            btnIcon.classList.add('animate-pulse');
        });
    </script>

</body>



</html>