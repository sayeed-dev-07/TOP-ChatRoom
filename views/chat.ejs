<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat Feed | Club Room</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Barrio&family=Outfit:wght@300;400;500;600;700&family=Permanent+Marker&family=Space+Mono:wght@400;700&family=Syne:wght@700;800&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/style.css">

    <style>
        body {
            font-family: 'Outfit', sans-serif;
        }

        .font-display {
            font-family: 'Syne', sans-serif;
        }

        .font-mono {
            font-family: 'Space Mono', monospace;
        }

        .font-brand {
            font-family: 'Barrio', system-ui;
        }

        .font-brush {
            font-family: 'Permanent Marker', cursive;
        }

        .vertical-text {
            writing-mode: vertical-rl;
            text-orientation: mixed;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 12px;
        }

        ::-webkit-scrollbar-track {
            background: #f4f4f5;
            border-left: 3px solid black;
        }

        ::-webkit-scrollbar-thumb {
            background: black;
            border: 2px solid #f4f4f5;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #FFE600;
        }
    </style>
</head>

<body
    class="bg-zinc-50 min-h-screen w-full flex antialiased text-black selection:bg-black selection:text-white overflow-x-hidden">

    <div
        class="hidden md:flex flex-col justify-between border-r-[3px] border-black w-24 p-6 shrink-0 bg-white h-screen sticky top-0 z-50">
        <div class="font-mono text-sm font-bold tracking-widest text-black/70">04</div>

        <div class="flex-1 flex items-center justify-center">
            <h1 class="font-brand vertical-text rotate-180 text-5xl font-bold whitespace-nowrap">
                The Feed
            </h1>
        </div>

        <div class="text-3xl font-black text-black text-center">話</div>
    </div>

    <div class="flex-1 flex flex-col min-h-screen w-full bg-zinc-50 relative">

        <header
            class="h-20 border-b-[3px] border-black flex justify-between items-center px-2.5 sm:px-6 md:px-10 shrink-0 bg-white sticky top-0 z-40">
            <div class="font-brand text-2xl font-bold tracking-widest">
                ClubRoom
            </div>
            <nav class="flex gap-4">
                <a href="/log-out"
                    class="font-mono text-sm font-black px-3 py-1.5 border-[3px] border-black uppercase tracking-widest hover:bg-black hover:text-white transition-colors duration-300">
                    Log Out
                </a>
            </nav>
        </header>

        <div
            class="w-full border-b-[3px] border-black bg-[#FFE600] flex flex-col xl:flex-row justify-between items-start xl:items-center p-2.5 sm:p-6 md:px-10 gap-6 z-30">

            <div class="flex flex-col gap-1">
                <h2 class="font-display text-3xl font-semibold uppercase tracking-tight">
                    Welcome, <span class="font-display text-[crimson]">
                        @<%= user.first_name %>
                    </span>
                </h2>
                <div class="font-mono text-xs font-bold uppercase tracking-widest flex items-center gap-2">
                    Status:
                    <% if (user.is_admin) { %>
                        <span class="bg-black text-[#FFE600] px-2 py-1">System Admin</span>
                        <% } else if (user.is_member) { %>
                            <span class="bg-white border-[2px] border-black px-2 py-1 text-black">Verified Member</span>
                            <% } else { %>
                                <span class="bg-zinc-300 border-[2px] border-black px-2 py-1 text-black">Guest</span>
                                <% } %>
                </div>
            </div>

            <div class="flex flex-wrap gap-3 w-full xl:w-auto">
                <% if (!user.is_member) { %>
                    <a href="/member"
                        class=" xl:flex-none text-center bg-white text-black border-[3px] border-black font-mono font-black uppercase text-xs px-4 py-3 hover:bg-black hover:text-white hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all">
                        Be Member
                    </a>
                    <% } %>

                        <% if (!user.is_admin) { %>
                            <a href="/admin"
                                class=" xl:flex-none text-center bg-zinc-200 text-black border-[3px] border-black font-mono font-black uppercase text-xs px-4 py-3 hover:bg-black hover:text-white hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all">
                                Be Admin
                            </a>
                            <% } %>

                                <a href="/new-message"
                                    class=" xl:flex-none text-center bg-black text-[#FFE600] border-[3px] border-black font-mono font-black uppercase text-xs px-6 py-3 hover:bg-white hover:text-black hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all flex items-center justify-center gap-2">
                                    <span>+</span> Drop Thought
                                </a>
            </div>
        </div>

        <main class="flex-1 mb-6 p-2.5 sm:p-6 md:p-10 w-full mx-auto flex flex-col">

            <div class="mb-6">
                <h3 class="font-brush text-5xl md:text-7xl transform -rotate-1 text-black mb-4">The Wall</h3>
                <p class="font-mono text-xs font-bold uppercase tracking-widest text-zinc-500">Latest thoughts from the
                    room</p>
            </div>

            <div class="flex flex-col gap-10 w-full relative z-10">

                <% if (messages && messages.length> 0) { %>
                    <% messages.forEach(message=> { %>

                        <article
                            class="w-full bg-white border-[3px] border-black flex flex-col xl:flex-row md:hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] transition-all duration-300 group overflow-hidden">

                            <div
                                class="w-full max-w-[450px] md:w-[400px] xl:w-[500px] shrink-0 border-b-[3px] md:border-b-0 md:border-r-[3px] border-black relative overflow-hidden flex items-center justify-center <%= message.img_link ? 'bg-zinc-100' : 'bg-zinc-900' %>">

                                <% if (message.img_link) { %>

                                    <img src="<%= message.img_link %>" alt="Attached image"
                                        class="w-full  aspect-square object-cover transition-transform duration-700 ease-in-out <%= (user.is_member) ? 'md:group-hover:scale-105' : 'blur-xl scale-110 select-none pointer-events-none' %>">

                                    <% if (!user.is_member ) { %>
                                        <div
                                            class="absolute inset-0 flex flex-col items-center justify-center bg-zinc-900/10 z-10">
                                            <div
                                                class="bg-[#FFE600] border-[3px] border-black px-4 py-2 font-mono text-sm font-black uppercase tracking-widest text-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transform -rotate-2">
                                                Members Only
                                            </div>
                                        </div>
                                        <% } %>

                                            <% } else { %>

                                                <div
                                                    class="w-full h-full min-h-[250px] bg-black flex flex-col items-center justify-center p-8 select-none">
                                                    <div
                                                        class="text-7xl md:text-9xl font-black text-zinc-800 mb-4 opacity-50">
                                                        無</div>
                                                    <div
                                                        class="font-mono text-[10px] font-bold uppercase tracking-widest text-zinc-500 border-t-[2px] border-zinc-800 pt-2">
                                                        Text Only / No Attachment
                                                    </div>
                                                </div>

                                                <% } %>

                            </div>

                            <div class="flex-1 flex flex-col sm:p-6 p-2.5 xl:p-10 relative">

                                <div
                                    class="absolute top-6 right-6 w-4 h-4 rounded-full border-[3px] border-black bg-[#FFE600]">
                                </div>

                                <div class="mb-4">
                                    <span
                                        class="inline-block bg-zinc-100 border-[2px] border-black font-mono text-[10px] font-bold uppercase tracking-widest px-3 py-1">
                                        <%= message.added_at || 'Today' %>
                                    </span>
                                </div>

                                <h4
                                    class="font-display sm:text-4xl text-3xl md:text-5xl font-semibold uppercase tracking-tighter mb-4 leading-none pr-8">
                                    <%= message.title %>
                                </h4>

                                <div
                                    class="font-mono text-[11px] font-bold uppercase tracking-widest text-zinc-500 mb-6 border-b-[3px] border-black pb-4">
                                    By: <span class="text-black">
                                        <%= message.first_name %> (@<%= message.username %>)
                                    </span>
                                </div>

                                <p
                                    class="text-lg md:text-xl font-medium leading-relaxed text-zinc-700 flex-grow whitespace-pre-wrap">
                                    <%= message.message %>
                                </p>
                                <div class="mt-auto pt-6 border-t-[3px] border-black flex justify-end">

                                    <form action="/<%= message.id %>/delete" method="post" class="m-0">

                                        <button type="submit" <%=user.is_admin ? '' : 'disabled' %>
                                            class="font-mono text-xs font-black uppercase tracking-widest px-6 py-2
                                            border-[3px] border-black transition-all duration-300
                                            <%= user.is_admin
                                                ? 'bg-red-500 text-white hover:bg-black hover:text-red-500 hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] cursor-pointer'
                                                : 'bg-zinc-200 text-zinc-400 opacity-60 cursor-not-allowed' %>"
                                                >
                                                Delete
                                        </button>

                                    </form>

                                </div>

                            </div>
                        </article>

                        <% }) %>
                            <% } else { %>

                                <div class="w-full bg-white border-[3px] border-black p-16 text-center border-dashed">
                                    <p class="font-mono font-bold text-lg uppercase tracking-widest text-zinc-500">The
                                        room is quiet. Be the first to drop a thought.</p>
                                </div>

                                <% } %>

            </div>
        </main>

    </div>
</body>

</html>