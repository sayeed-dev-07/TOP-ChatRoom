<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat Feed | Club Room</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Barrio&family=Outfit:wght@300;400;500;600;700&family=Permanent+Marker&family=Space+Mono:wght@400;700&family=Syne:wght@700;800&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/style.css">

    <style>
        body {
            font-family: 'Outfit', sans-serif;
        }

        .font-display {
            font-family: 'Syne', sans-serif;
        }

        .font-mono {
            font-family: 'Space Mono', monospace;
        }

        .font-brand {
            font-family: 'Barrio', system-ui;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-track {
            background: #f4f4f5;
            border-left: 2px solid black;
        }

        ::-webkit-scrollbar-thumb {
            background: black;
            border: 2px solid #f4f4f5;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #FFE600;
        }
    </style>
</head>

<body
    class="bg-zinc-50 min-h-screen w-full flex flex-col antialiased text-black selection:bg-black selection:text-white overflow-x-hidden">

    <!-- Global Full-Width Header -->
    <header class="w-full border-b-[3px] border-black bg-white sticky top-0 z-50">
        <div class="max-w-5xl mx-auto min-h-[4rem] flex justify-between items-center px-4 md:px-6 py-3">
            <div class="font-brand text-2xl font-bold tracking-widest">
                ClubRoom
            </div>
            <nav class="flex gap-4">
                <a href="/log-out"
                    class="font-mono text-xs font-bold px-5 py-2 border-[2px] hover:bg-black hover:text-[#FFE600] border-black uppercase tracking-widest transition-all">
                    Log Out
                </a>
            </nav>
        </div>
    </header>

    <!-- Minimal Action & Status Bar -->
    <section class="w-full bg-white border-b-[3px] border-black">
        <div class="max-w-5xl mx-auto px-4 md:px-6 py-8 md:py-12">

            <div class="mb-8">
                <h1 class="font-display text-4xl md:text-5xl font-semibold uppercase tracking-tighter mb-2 text-black">
                    The Feed.
                </h1>
                <p class="text-base font-medium text-zinc-600 border-l-[3px] border-[#FFE600] pl-4 max-w-lg">
                    Latest thoughts, ideas, and updates from the room.
                </p>
            </div>

            <div
                class="bg-zinc-100 border-[3px] border-black p-5 md:p-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6">
                <div class="flex flex-col gap-1">
                    <div class="font-display text-xl font-bold uppercase tracking-tight">
                        @<%= user.username || user.first_name %>
                    </div>
                    <div class="font-mono text-[10px] font-bold uppercase tracking-widest text-zinc-500">
                        Role:
                        <% if (user.is_admin) { %> <span class="text-black bg-[#FFE600] px-1">Admin</span>
                            <% } else if (user.is_member) { %> <span class="text-black">Member</span>
                                <% } else { %> <span class="text-black">Guest</span>
                                    <% } %>
                    </div>
                </div>

                <div class="flex flex-wrap gap-3 w-full sm:w-auto">
                    <% if (!user.is_member) { %>
                        <a href="/member"
                            class="text-center bg-white text-black border-[2px] border-black font-mono font-bold uppercase text-xs px-4 py-2 hover:bg-black hover:text-white transition-all shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px]">Be
                            Member</a>
                        <% } %>

                            <% if (!user.is_admin) { %>
                                <a href="/admin"
                                    class="text-center bg-white text-black border-[2px] border-black font-mono font-bold uppercase text-xs px-4 py-2 hover:bg-black hover:text-white transition-all shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px]">Be
                                    Admin</a>
                                <% } %>

                                    <a href="/app/new-message"
                                        class="text-center bg-[#FFE600] text-black border-[2px] border-black font-mono font-bold uppercase text-xs px-6 py-2 hover:bg-black hover:text-[#FFE600] transition-all shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px] flex items-center justify-center gap-2">
                                        <span>✏️</span> Drop Thought
                                    </a>
                </div>
            </div>

        </div>
    </section>

    <!-- Compact Feed / The Wall -->
    <main class="w-full flex-1 bg-zinc-50 py-10 px-4 md:px-6 flex flex-col items-center">

        <div class="w-full max-w-5xl flex flex-col gap-6">
            <h3
                class="font-mono text-sm font-bold uppercase tracking-widest text-zinc-500 border-b-[2px] border-black pb-2 mb-2">
                All thoughts
            </h3>

            <% if (messages && messages.length> 0) { %>
                <% messages.forEach(message=> { %>

                    <!-- CSS Grid Post Card (Prevents Flexbox Blowout) -->
                    <article
                        class="w-full bg-white border-[3px] border-black flex flex-wrap hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] transition-shadow duration-200 overflow-hidden">

                        <!-- Fixed Image Area -->
                        <div
                            class="border-b-[3px] aspect-video sm:aspect-auto sm:border-b-0 sm:border-r-[3px] border-black bg-zinc-100 relative w-full sm:w-[250px] md:w-[350px]  flex items-center justify-center">
                            <% if (message.img_link) { %>
                                <img src="<%= message.img_link %>" alt="Post image"
                                    class="w-full aspect-video sm:aspect-auto h-full object-cover <%= (user.is_member) ? '' : 'blur-md select-none pointer-events-none' %>">

                                <% if (!user.is_member) { %>
                                    <div class="absolute inset-0 flex items-center justify-center bg-zinc-900/10 z-10">
                                        <div
                                            class="bg-[#FFE600] border-[2px] border-black px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-wider text-black">
                                            Members Only
                                        </div>
                                    </div>
                                    <% } %>
                                        <% } else { %>
                                            <div
                                                class="w-full h-full flex flex-col items-center justify-center p-4 text-black/40">
                                                <div class="text-4xl mb-1">💬</div>
                                                <div class="font-mono text-[9px] font-bold uppercase tracking-widest">No
                                                    Image</div>
                                            </div>
                                            <% } %>
                        </div>

                        <!-- Fixed Content Area (min-w-0 prevents text push) -->
                        <div class="flex flex-1 flex-col p-5 sm:p-8  bg-white">

                            <div class="flex flex-wrap sm:justify-between sm:items-start mb-2 gap-2">
                                <h4
                                    class="font-display text-xl sm:text-2xl font-bold uppercase tracking-tight text-black leading-tight break-words">
                                    <%= message.title %>
                                </h4>
                                <span
                                    class="font-mono text-[9px] font-bold wrap-break-word uppercase text-zinc-500  sm:mt-1">
                                    <%= message.added_at || 'Today' %>
                                </span>
                            </div>

                            <div
                                class="font-mono text-[10px] font-bold uppercase tracking-widest text-zinc-500 mb-4 border-b-[2px] border-black pb-2">
                                By <span class="text-black">@<%= message.username %></span>
                            </div>

                            <p
                                class="text-sm sm:text-base text-zinc-700 leading-relaxed whitespace-pre-wrap flex-grow mb-6 break-words">
                                <%= message.message %>
                            </p>

                            <!-- Delete Button -->
                            <div class="mt-auto pt-4 border-t-[2px] border-zinc-200 flex justify-end">
                                <form action="/app/<%= message.id %>/delete" method="post" class="m-0">
                                    <button type="submit" <%=user.is_admin ? '' : 'disabled' %>
                                        class="font-mono text-[10px] font-bold uppercase tracking-widest px-4 py-1.5
                                        border-[2px] border-black transition-colors
                                        <%= user.is_admin ? 'bg-red-500 text-white hover:bg-black cursor-pointer'
                                            : 'bg-zinc-200 text-zinc-400 opacity-60 cursor-not-allowed' %>">
                                            Delete Post
                                    </button>
                                </form>
                            </div>

                        </div>
                    </article>

                    <% }) %>
                        <% } else { %>
                            <div class="w-full bg-white border-[3px] border-black p-10 text-center">
                                <p class="font-mono font-bold text-sm uppercase tracking-widest text-zinc-500">The board
                                    is empty right now.</p>
                            </div>
                            <% } %>
        </div>
    </main>

    <!-- Simple Footer (Logged In) -->
    <footer class="w-full bg-white border-t-[3px] border-black py-6 text-center mt-auto">
        <div class="font-mono text-[10px] font-bold uppercase tracking-widest text-zinc-500">
            Created by <a target="_blank" class="text-black hover:underline"
                href="https://github.com/sayeed-dev-07">Sayeed</a>
        </div>
    </footer>

</body>

</html>