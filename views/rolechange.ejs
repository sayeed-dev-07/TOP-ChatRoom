<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verification | Club Room</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Barrio&family=Outfit:wght@300;400;500;600;700&family=Permanent+Marker&family=Space+Mono:wght@400;700&family=Syne:wght@700;800&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/style.css">

    <style>
        body {
            font-family: 'Outfit', sans-serif;
        }

        .font-display {
            font-family: 'Syne', sans-serif;
        }

        .font-mono {
            font-family: 'Space Mono', monospace;
        }

        .font-brand {
            font-family: 'Barrio', system-ui;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-track {
            background: #f4f4f5;
            border-left: 2px solid black;
        }

        ::-webkit-scrollbar-thumb {
            background: black;
            border: 2px solid #f4f4f5;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #FFE600;
        }
    </style>
</head>

<body
    class="bg-zinc-50 min-h-screen w-full flex flex-col antialiased text-black selection:bg-black selection:text-white overflow-x-hidden">

    <!-- Global Full-Width Header -->
    <header class="w-full border-b-[3px] border-black bg-white sticky top-0 z-50">
        <div class="max-w-5xl mx-auto min-h-[4rem] flex justify-between items-center px-4 md:px-6 py-3">
            <div class="font-brand text-2xl font-bold tracking-widest">
                ClubRoom
            </div>
            <nav class="flex gap-4">
                <a href="/app"
                    class="font-mono text-xs font-bold px-4 py-2 border-[2px] border-black hover:bg-black hover:text-[#FFE600] uppercase tracking-widest transition-all flex items-center gap-2">
                    <span>←</span> Back to Feed
                </a>
            </nav>
        </div>
    </header>

    <!-- Dynamic Hero Section -->
    <section class="w-full bg-white border-b-[3px] border-black">
        <div class="max-w-5xl mx-auto px-4 md:px-6 py-10 md:py-12">

            <% if (userRole) { %>
                <h1 class="font-display text-4xl md:text-5xl font-semibold uppercase tracking-tighter mb-4 text-black">
                    Role Confirmed.
                </h1>
                <p class="text-base font-medium text-zinc-600 border-l-[3px] border-[#FFE600] pl-4 max-w-lg">
                    You already hold the <span
                        class="bg-black text-[#FFE600] px-1 font-bold uppercase tracking-wider text-xs">
                        <%= position %>
                    </span> rank. No further verification is needed.
                </p>
                <% } else { %>
                    <h1
                        class="font-display text-4xl md:text-5xl font-semibold uppercase tracking-tighter mb-4 text-black">
                        Verification page.
                    </h1>
                    <p class="text-base font-medium text-zinc-600 border-l-[3px] border-[#FFE600] pl-4 max-w-lg">
                        To claim the <span
                            class="bg-black text-[#FFE600] px-1 font-bold uppercase tracking-wider text-xs">
                            <%= position %>
                        </span> role, you must prove your knowledge. Identify the character below.
                    </p>
                    <% } %>

        </div>
    </section>

    <!-- Main Content Area -->
    <main class="w-full flex-1 bg-zinc-50 py-10 px-4 md:px-6 flex flex-col items-center justify-center relative">

        <div
            class="absolute right-10 bottom-10 text-[15rem] font-black text-black opacity-[0.03] pointer-events-none select-none">
            証
        </div>

        <div
            class="w-full max-w-4xl bg-white border-[3px] border-black grid grid-cols-1 md:grid-cols-2 sm:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] relative z-10 overflow-hidden">

            <!-- Left: Target Image Column -->
            <div
                class="border-b-[3px] md:border-b-0 md:border-r-[3px] border-black bg-zinc-100 p-8 flex flex-col items-center justify-center relative">

                <!-- Crosshair Decals -->
                <div class="absolute top-4 left-4 w-4 h-4 border-t-[3px] border-l-[3px] border-black"></div>
                <div class="absolute top-4 right-4 w-4 h-4 border-t-[3px] border-r-[3px] border-black"></div>
                <div class="absolute bottom-4 left-4 w-4 h-4 border-b-[3px] border-l-[3px] border-black"></div>
                <div class="absolute bottom-4 right-4 w-4 h-4 border-b-[3px] border-r-[3px] border-black"></div>

                <img src="<%= position === 'admin' ? 'https://i.pinimg.com/736x/94/3b/5b/943b5b3b6c43b5dd2eaa588f60dc32f0.jpg' : 'https://i.pinimg.com/736x/27/f5/f8/27f5f8baaefe10515e302be0144a8a2e.jpg' %>"
                    alt="Security Target"
                    class="w-full max-w-[240px] border-[3px] border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] filter grayscale-[30%] hover:grayscale-0 transition-all duration-500 ease-in-out">

                <div
                    class="mt-6 font-mono text-[10px] font-bold uppercase tracking-widest text-zinc-500 bg-white border-[2px] border-black px-3 py-1">
                    Target Entity Identified
                </div>
            </div>

            <!-- Right: Action Column -->
            <div class="p-6 md:p-10 flex flex-col justify-center bg-white">

                <% if (userRole) { %>
                    <!-- Already Verified State -->
                    <a href="/app"
                        class="w-full bg-[#FFE600] text-black border-[3px] border-black font-mono font-bold uppercase tracking-widest text-sm py-4 hover:bg-black hover:text-[#FFE600] hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all duration-300 flex items-center justify-center gap-3 group">
                        Return to Feed
                        <span class="text-xl group-hover:translate-x-1 transition-transform">→</span>
                    </a>

                    <% } else { %>

                        <!-- Error State -->
                        <% if (locals.error) { %>
                            <div
                                class="mb-8 bg-red-500 border-[3px] border-black p-4 text-white shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transform -rotate-1">
                                <h3 class="font-display text-xl font-bold uppercase tracking-tight mb-1">⚠ Access Denied
                                </h3>
                                <p class="font-mono text-[10px] font-bold tracking-wider">
                                    <%= locals.error %>
                                </p>
                                <div
                                    class="mt-2 pt-2 border-t-[2px] border-red-400 font-mono text-[9px] uppercase text-red-100">
                                    The room rejects your answer. Try again.
                                </div>
                            </div>
                            <% } %>

                                <!-- Admin Lockout State -->
                                <% if (position==='admin' ) { %>
                                    <div
                                        class="mb-4 bg-zinc-200 border-[3px] border-black p-5 relative shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
                                        <div
                                            class="font-display text-sm font-black uppercase text-black mb-2 border-b-[2px] border-black pb-1 inline-block tracking-tight">
                                            ⚠ Security Notice
                                        </div>
                                        <p
                                            class="font-mono text-xs font-bold text-zinc-700 uppercase mt-1 leading-relaxed">
                                            Admin permissions are <span
                                                class="bg-black text-white px-1 py-0.5">LOCKED</span>. <br>
                                            I am no longer granting the admin role via character names because people
                                            are deleting others' posts.
                                        </p>
                                    </div>
                                    <% } else { %>
                                        <!-- Form State -->
                                        <form action="/<%= position %>" method="POST"
                                            class="flex flex-col gap-5 w-full">
                                            <div class="flex flex-col gap-2">
                                                <label for="answer"
                                                    class="font-mono text-xs font-bold uppercase tracking-widest text-zinc-600">Enter
                                                    Target's First Name</label>
                                                <input type="text" name="answer" id="answer" required autocomplete="off"
                                                    class="w-full border-[2px] border-black p-3 text-lg font-bold bg-zinc-50 focus:bg-[#FFE600] focus:outline-none focus:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all placeholder:text-zinc-300 font-mono"
                                                    placeholder="First Name...">
                                            </div>

                                            <button type="submit"
                                                class="mt-2 w-full bg-black text-[#FFE600] border-[2px] border-black font-mono font-bold uppercase tracking-widest text-sm py-3 hover:bg-[#FFE600] hover:text-black hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all duration-300 flex items-center justify-center gap-3 group">
                                                Submit Passcode
                                                <span
                                                    class="text-xl group-hover:translate-x-1 transition-transform">→</span>
                                            </button>
                                        </form>
                                        <% } %>

                                            <% } %>

            </div>
        </div>
    </main>

    <!-- Simple Footer -->
    <footer class="w-full bg-white border-t-[3px] border-black py-6 text-center mt-auto relative z-20">
        <div class="font-mono text-[10px] font-bold uppercase tracking-widest text-zinc-500">
            Created by <a target="_blank" class="text-black hover:underline"
                href="https://github.com/sayeed-dev-07">Sayeed</a>
        </div>
    </footer>

</body>

</html>