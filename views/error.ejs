<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Access Denied | Club Room</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Barrio&family=Outfit:wght@300;400;500;600;700&family=Permanent+Marker&family=Space+Mono:wght@400;700&family=Syne:wght@700;800&display=swap"
        rel="stylesheet">

    
    <link rel="stylesheet" href="/style.css">

    <style>
        body {
            font-family: 'Outfit', sans-serif;
        }

        .font-display {
            font-family: 'Syne', sans-serif;
        }

        .font-mono {
            font-family: 'Space Mono', monospace;
        }

        .font-brand {
            font-family: 'Barrio', system-ui;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-track {
            background: #f4f4f5;
            border-left: 2px solid black;
        }

        ::-webkit-scrollbar-thumb {
            background: black;
            border: 2px solid #f4f4f5;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #FFE600;
        }
    </style>
</head>

<body
    class="bg-white min-h-screen w-full flex flex-col antialiased text-black selection:bg-black selection:text-white overflow-x-hidden">

    <!-- Global Full-Width Header -->
    <header class="w-full border-b-[3px] border-black  sticky top-0 z-50">
        <div class="max-w-5xl mx-auto min-h-[4rem] flex justify-between items-center px-4 md:px-6 py-3">
            <a href="/"
                class="font-brand text-2xl font-bold tracking-widest hover:text-[#FFE600] transition-colors cursor-pointer">
                ClubRoom
            </a>
            <nav class="flex gap-4">
                <a href="/log-out"
                    class="font-mono text-xs font-bold px-5 py-2 border-[2px] hover:bg-black hover:text-[#FFE600] border-black uppercase tracking-widest transition-all">
                    Log Out
                </a>
            </nav>
        </div>
    </header>

    <!-- Error Content -->
    <main class="w-full flex-1 flex items-center justify-center p-6">
        <div
            class="max-w-xl w-full  sm:border-[3px] border-black sm:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] sm:p-8 md:p-12 relative overflow-hidden">



            <div class="flex flex-col items-center text-center mt-4">


                <!-- Error Code & Title -->
                <h3
                    class="font-mono text-sm font-bold uppercase tracking-widest text-zinc-500 border-b-[2px] border-black pb-2 mb-4 w-full">
                    No permission: 401
                </h3>

                <h1 class="font-display text-4xl md:text-5xl font-semibold uppercase tracking-tighter mb-4 text-black">
                    Access Denied
                </h1>

                <!-- Dynamic Error Message passed from res.render -->
                <div class="bg-zinc-100 border-[2px] border-black p-4 w-full mb-8">
                    <p class="font-mono text-sm md:text-base font-bold text-red-600 uppercase tracking-wide">
                        > <%= message || "You are not authorized to view this resource." %>
                    </p>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-col sm:flex-row gap-4 w-full justify-center">
                    <a href="/"
                        class="text-center bg-white text-black border-[2px] border-black font-mono font-bold uppercase text-xs px-6 py-3 hover:bg-black hover:text-white transition-all sm:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px]">
                        Homepage
                    </a>
                    <a href="/app"
                        class="text-center bg-[#FFE600] text-black border-[2px] border-black font-mono font-bold uppercase text-xs px-6 py-3 hover:bg-black hover:text-[#FFE600] transition-all sm:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px]">
                        Return to Feed
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- Simple Footer -->
    <footer class="w-full bg-white border-t-[3px] border-black py-6 text-center mt-auto">
        <div class="font-mono text-[10px] font-bold uppercase tracking-widest text-zinc-500">
            Created by <a target="_blank" class="text-black hover:underline"
                href="https://github.com/sayeed-dev-07">Sayeed</a>
        </div>
    </footer>

</body>

</html>
