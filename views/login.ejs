<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log-in | Club Room</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Barrio&family=Outfit:wght@300;400;500;600;700&family=Permanent+Marker&family=Space+Mono:wght@400;700&family=Syne:wght@700;800&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/style.css">

    <style>
        body {
            font-family: 'Outfit', sans-serif;
        }

        .font-display {
            font-family: 'Syne', sans-serif;
        }

        .font-mono {
            font-family: 'Space Mono', monospace;
        }

        .font-brand {
            font-family: 'Barrio', system-ui;
        }

        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-track {
            background: #f4f4f5;
            border-left: 2px solid black;
        }

        ::-webkit-scrollbar-thumb {
            background: black;
            border: 2px solid #f4f4f5;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #FFE600;
        }
    </style>
</head>

<body
    class="bg-zinc-50 min-h-screen w-full flex flex-col antialiased text-black selection:bg-black selection:text-white overflow-x-hidden">

    <!-- Global Full-Width Header -->
    <header class="w-full border-b-[3px] border-black bg-white sticky top-0 z-50">
        <div class="max-w-5xl mx-auto min-h-[4rem] flex justify-between items-center px-4 md:px-6 py-3">
            <div class="font-brand text-2xl font-bold tracking-widest">
                ClubRoom
            </div>
            <nav class="flex gap-4">
                <a href="/"
                    class="font-mono text-xs font-bold px-4 py-2 border-[2px] border-black hover:bg-black hover:text-[#FFE600] uppercase tracking-widest transition-all flex items-center gap-2">
                    <span>←</span> Home
                </a>
            </nav>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="w-full bg-white border-b-[3px] border-black">
        <div class="max-w-5xl mx-auto px-4 md:px-6 py-10 md:py-12">
            <h1 class="font-display text-4xl md:text-5xl font-semibold uppercase tracking-tighter mb-4 text-black">
                Welcome Back.
            </h1>
            <p class="text-base font-medium text-zinc-600 border-l-[3px] border-[#FFE600] pl-4 max-w-lg">
                Access your terminal. Enter your credentials to view the feed and drop your thoughts.
            </p>
        </div>
    </section>

    <!-- Main Content Area -->
    <main class="w-full flex-1 bg-zinc-50 py-10 px-4 md:px-6 flex flex-col items-center justify-center relative">

        <div
            class="absolute right-10 bottom-10 text-[15rem] font-semibold text-black opacity-[0.03] pointer-events-none select-none">
            入
        </div>

        <!-- Split Grid Container -->
        <div
            class="w-full max-w-4xl bg-white border-[3px] border-black grid grid-cols-1 md:grid-cols-2 sm:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] relative z-10 overflow-hidden">

            <!-- Left: Graphic Branding Column -->
            <div
                class="border-b-[3px] md:border-b-0 md:border-r-[3px] border-black bg-[#FFE600] p-8 flex flex-col items-center justify-center relative overflow-hidden min-h-[250px]">

                <!-- Crosshair Decals -->
                <div class="absolute top-4 left-4 w-4 h-4 border-t-[3px] border-l-[3px] border-black"></div>
                <div class="absolute top-4 right-4 w-4 h-4 border-t-[3px] border-r-[3px] border-black"></div>
                <div class="absolute bottom-4 left-4 w-4 h-4 border-b-[3px] border-l-[3px] border-black"></div>
                <div class="absolute bottom-4 right-4 w-4 h-4 border-b-[3px] border-r-[3px] border-black"></div>

                <div
                    class="absolute -right-8 -bottom-8 text-[12rem] font-semibold text-black opacity-10 pointer-events-none select-none leading-none">
                    入
                </div>

                <div class="z-10 flex flex-col items-center gap-4">
                    <div
                        class="font-mono text-xl font-semibold bg-black text-[#FFE600] px-4 py-1 border-[2px] border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,0.2)]">
                        02</div>
                    <h2
                        class="font-display wrap-break-word text-[7vw] sm:text-4xl font-semibold uppercase tracking-tighter text-center">
                        Authorization<br>Required</h2>
                </div>
            </div>

            <!-- Right: Form Column -->
            <div class="p-6 md:p-10 flex flex-col justify-center bg-white relative">

                <% if (locals.errorMessage) { %>
                    <div
                        class="w-full mb-6 bg-red-500 text-white border-[2px] border-black p-3 font-mono text-xs font-bold uppercase tracking-wider flex items-center gap-3 relative z-10">
                        <span class="text-xl leading-none">!</span>
                        <%= errorMessage %>
                    </div>
                    <% } %>

                        <form action="/log-in" method="post" class="flex flex-col gap-5 w-full relative z-10">

                            <div class="flex flex-col gap-2">
                                <label for="username"
                                    class="font-mono text-xs font-bold uppercase tracking-widest text-zinc-600">Enter
                                    Username</label>
                                <input type="text" id="username" name="username" required autocomplete="username"
                                    class="w-full border-[2px] border-black p-3 text-base font-bold bg-zinc-50 focus:bg-[#FFE600] focus:outline-none focus:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all placeholder:text-zinc-300 font-mono"
                                    placeholder="ClubMember99">
                            </div>

                            <div class="flex flex-col gap-2">
                                <label for="password"
                                    class="font-mono text-xs font-bold uppercase tracking-widest text-zinc-600">Enter
                                    Password</label>

                                <div class="relative w-full">
                                    <input type="password" id="password" name="password" required
                                        class="w-full border-[2px] border-black p-3 pr-12 text-base font-bold bg-zinc-50 focus:bg-[#FFE600] focus:outline-none focus:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all placeholder:text-zinc-300 font-mono"
                                        placeholder="••••••••">

                                    <button type="button" id="togglePassword"
                                        class="absolute inset-y-0 right-0 px-3 flex items-center justify-center text-zinc-400 hover:text-black transition-colors focus:outline-none cursor-pointer"
                                        aria-label="Toggle password visibility">

                                        <svg id="eyeOpen" xmlns="http://www.w3.org/2000/svg" fill="none"
                                            viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                        </svg>

                                        <svg id="eyeClosed" xmlns="http://www.w3.org/2000/svg" fill="none"
                                            viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
                                            class="w-5 h-5 hidden">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <button type="submit"
                                class="mt-2 w-full cursor-pointer bg-black text-[#FFE600] border-[2px] border-black font-mono font-bold uppercase tracking-widest text-sm py-3 hover:bg-[#FFE600] hover:text-black hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all duration-300 flex items-center justify-center gap-3 group">
                                Log in
                                <span class="text-xl group-hover:translate-x-1 transition-transform">→</span>
                            </button>

                            <div class="mt-4 text-center">
                                <p class="font-mono text-[10px] font-bold uppercase tracking-widest text-zinc-500">
                                    Don't have a account? <a href="/sign-up"
                                        class="text-black border-b-[2px] border-black hover:text-[#FFE600] hover:bg-black transition-colors px-1">Sign
                                        Up</a>
                                </p>
                            </div>

                        </form>
            </div>
        </div>
    </main>

    <footer class="w-full bg-white border-t-[3px] border-black py-6 text-center mt-auto relative z-20">
        <div class="font-mono text-[10px] font-bold uppercase tracking-widest text-zinc-500">
            Created by <a target="_blank" class="text-black hover:underline"
                href="https://github.com/sayeed-dev-07">Sayeed</a>
        </div>
    </footer>

    <script>
        const togglePasswordBtn = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('password');
        const eyeOpen = document.getElementById('eyeOpen');
        const eyeClosed = document.getElementById('eyeClosed');

        togglePasswordBtn.addEventListener('click', function () {
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);
            eyeOpen.classList.toggle('hidden');
            eyeClosed.classList.toggle('hidden');
        });
    </script>
</body>

</html>